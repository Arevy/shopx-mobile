# Resolve react_native_pods.rb with node to allow for hoisting
require_relative 'fmt_compatibility'
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'shopxMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # Enable Hermes for better startup performance and memory usage.
    :hermes_enabled => true,
    # Opt-in Fabric/new architecture to align with latest RN toolchain.
    :fabric_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'shopxMobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    patch_fmt_string_view(installer.sandbox.root.to_s)
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Resource/privacy bundles in older dependencies can retain iOS 9 targets.
    # Keep every pod target at least at React Native's supported minimum.
    minimum_ios = Gem::Version.new(min_ios_version_supported)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |configuration|
        deployment_target = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || (deployment_target.match?(/\A\d+(\.\d+)*\z/) && Gem::Version.new(deployment_target) < minimum_ios)
          configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios.to_s
        end
      end
    end
  end
end
